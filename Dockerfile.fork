# Custom sonos-http-api image built from the local forks in /home/media/pr-work.
#
# Build context is /home/media/pr-work so both repositories are available:
#   node-sonos-http-api  (this repo, integration/sonos-fixes)
#   node-sonos-discovery (integration/sonos-fixes, referenced via file:./sonos-discovery)
#
#   docker build -f node-sonos-http-api/Dockerfile.fork -t sonos-http-api:fork /home/media/pr-work

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS builder

WORKDIR /app
ENV NODE_ENV=development

COPY node-sonos-http-api/ /app/
COPY node-sonos-discovery/ /app/sonos-discovery/

# Build the discovery dependency first so the file: dependency exposes its lib/ output.
RUN cd /app/sonos-discovery \
    && npm ci --ignore-scripts --no-audit --no-fund \
    && npm run build \
    && rm -rf node_modules /tmp/* /root/.npm

RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm run build \
    && rm -rf /tmp/* /root/.npm

# --- Runtime image ---
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

LABEL org.opencontainers.image.title="sonos-http-api (fork)"
LABEL org.opencontainers.image.description="Fork of node-sonos-http-api by Jimmy Shimizu"
LABEL org.opencontainers.image.source="https://github.com/Trudge/node-sonos-http-api"
LABEL org.opencontainers.image.licenses="MIT"

ARG PUID=1001
ARG PGID=3001

WORKDIR /app
ENV NODE_ENV=production APP_ROOT=/app HOME=/tmp

COPY --from=builder /app/dist/ /app/
COPY --from=builder /app/package.json /app/package-lock.json /app/
COPY --from=builder /app/sonos-discovery/ /app/sonos-discovery/
COPY --from=builder /app/static/ /app/static/
COPY --from=builder /app/presets/ /app/presets/
COPY --from=builder /app/LICENSE.md /app/ATTRIBUTION.md /app/

RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && rm -rf /tmp/* /root/.npm \
    && mkdir -p cache static/tts \
    && chown -R "${PUID}:${PGID}" /app

EXPOSE 5005 5006

USER ${PUID}:${PGID}

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -q -T 5 -O /dev/null http://127.0.0.1:5005/zones || exit 1

CMD ["node", "src/server.js"]
