{
  "name": "sonos-http-api",
  "version": "1.7.0",
  "description": "A simple node app for controlling a Sonos system with basic HTTP requests",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx server.js",
    "build": "rm -rf dist && tsc && cp package.json dist/package.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint lib",
    "test": "tsx --test --test-force-exit test/*.test.js test/*.test.ts",
    "coverage": "c8 --all --include='src/report/**/*.ts' --include='src/fs/**/*.ts' --include='src/settings.ts' --include='src/http/**/*.ts' --include='lib/actions/*.ts' --include='lib/actions/report.js' --include='lib/helpers/safe-path.js' --include='lib/helpers/file-duration.ts' --exclude='**/*.d.ts' --check-coverage --lines 80 --functions 90 --branches 60 --reporter=text --reporter=lcov npm test",
    "pretest": "npm run build"
  },
  "author": "Jimmy Shimizu <jimmy@shimizu.se>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jishi/node-sonos-http-api.git"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1152.0",
    "basic-auth": "~1.1.0",
    "fuse.js": "^6.4.1",
    "html-entities": "^1.2.1",
    "json5": "^2.2.3",
    "mime": "^1.4.1",
    "music-metadata": "^12.2.3",
    "serve-static": "^1.15.0",
    "sonos-discovery": "file:./sonos-discovery",
    "wav-file-info": "0.0.8"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "main": "dist/server.js",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "eslint": "^4.8.0",
    "eslint-config-airbnb-base": "^12.0.1",
    "eslint-plugin-import": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "contributors": [
    "Trudge and contributors (fork modifications)"
  ]
}
